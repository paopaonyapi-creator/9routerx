# 9routerx environment contract
# Copy to .env and fill in values.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Server
PORT=888

# OAuth client credentials
# Set these to override built-in defaults. Hardcoded fallbacks exist for
# well-known public clients (antigravity, gemini-cli, xai, codex, iflow, etc.)
# so most users don't need to touch these.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing. Same effect as the
# "Force Fallback" toggle in Settings -> Default Routing Strategy; upstream parity.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# Set to true or 1 to forbid the insecure-TLS retry. By default a request that
# fails certificate verification is replayed once with verification disabled,
# which is what gets through a corporate proxy or antivirus that re-signs TLS.
# STRICT_SSL=true

# Observability
# Log verbosity (debug|info|warn|error), encoding (text|json), and an extra
# log file. The background daemon always mirrors to DATA_DIR/run/gateway.log.
# LOG_LEVEL=info
# LOG_FORMAT=text
# LOG_FILE=

# Self-update
# Hours between background update checks (AUTO_UPDATE must be true).
# AUTO_UPDATE_INTERVAL_HOURS=6

# Web-session executors (chatgpt-web, gemini-web, deepseek-web, muse-web).
# OFF by default; set true only if you use browser-session providers.
# ENABLE_WEB_EXECUTORS=true

# SSRF guard release valves — leave unset in production. ALLOW_PRIVATE_
# NETWORKING lets the gateway dial loopback/private addresses; ALLOW_PRIVATE_
# PROVIDER_URLS additionally permits provider endpoints on those ranges.
# ALLOW_PRIVATE_NETWORKING=true
# ALLOW_PRIVATE_PROVIDER_URLS=true

# MITM: skip installing the local CA (tests/CI).
# NO_INSTALL_CA=1

# Routing / proxy behavior knobs (all have sensible built-in defaults)
# X-Route-* response headers naming the provider/model that served a request.
# 9ROUTERX_ROUTE_HEADERS=false
# Gateway URL written into CLI tool config snippets (default: request origin).
# 9ROUTERX_URL=https://gw.example.com
# Kill a stream that produced no bytes for this many milliseconds.
# 9ROUTERX_STREAM_STALL_TIMEOUT_MS=45000
# Per-seat retry budget (ms) for transient upstream attempts in a combo.
# 9ROUTERX_SEAT_ATTEMPT_BUDGET_MS=10000
# Real client IP from a front proxy: with this token set, a proxy presenting it
# via x-9r-peer-token may stamp x-9r-real-ip for login rate-limit bucketing.
# 9ROUTERX_PEER_TOKEN=

# Service / A2A / MCP
# Force the "9routerx service install" backend (systemd|launchd|openrc|runit|cron).
# 9ROUTERX_SERVICE_BACKEND=cron
# A2A endpoints: enable + bearer token (required auth when set).
# ROUTERX_ENABLE_A2A=true
# ROUTERX_A2A_TOKEN=
# MCP server endpoint bearer token; empty disables the endpoint.
# ROUTERX_MCP_TOKEN=

# Provider-specific helpers
# Cloudflare account for the Cloudflare image provider.
# CLOUDFLARE_ACCOUNT_ID=
# Explicit Chrome profile password candidate for the cookie reader.
# CHROME_PASS=

# Pre-rebrand spellings (9ROUTERX_* / NINEROUTER_*) still answer for one
# release with a deprecation warning on stderr; rename them when you see it.
